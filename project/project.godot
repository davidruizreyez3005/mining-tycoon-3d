; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mining Tycoon 3D"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[application/config]

version/major=1
version/minor=0
version/patch=0
version/build=0
version/status="dev"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_maps]

ui_touch_interaction={
"deadzone": 0.5,
"events": [Object(InputEventAction,"resource_local_to_scene":false,"resource_name":"","device":-1,"action":"touch","pressed":true)
]
}
ui_pan_camera={
"deadzone": 0.5,
"events": [Object(InputEventMouseMotion,"resource_local_to_scene":false,"resource_name":"","position":Vector2(0, 0),"relative":Vector2(0, 0),"screen_relative":Vector2(0, 0),"button_mask":0,"shift_pressed":false,"alt_pressed":false,"meta_pressed":false,"ctrl_pressed":false)
]
}
ui_zoom={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":0,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
ui_select={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"echo":false,"pressed":true)
]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Resources"
3d_physics/layer_4="Machinery"
3d_physics/layer_5="Workers"
3d_physics/layer_6="Projectiles"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/basis_universal/ktx2_software_encoders/etc2_rgba8=true
lighting/directional_shadows/atlas_resolution=2048

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[editor_plugins]

enabled=PackedStringArray()
