; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mining Tycoon 3D"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
GameState="*res://scripts/core/game_state.gd"
EconomySystem="*res://scripts/systems/economy_system.gd"
InputSystem="*res://scripts/systems/input_system.gd"
ResourceManager="*res://scripts/systems/resource_manager.gd"
WorkerManager="*res://scripts/systems/worker_manager.gd"
MachineManager="*res://scripts/systems/machine_manager.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
UIManager="*res://scripts/ui/ui_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

